{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalshicore.dev/sources/schemas/openapi-operations.schema.json",
  "title": "KalshiCore OpenAPI operation inventory",
  "type": "object",
  "required": [
    "sourceId",
    "url",
    "version",
    "sha256",
    "operationCount",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operationCount": {
      "type": "integer",
      "minimum": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "method",
          "operationId"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repeatedQueryParameters": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
