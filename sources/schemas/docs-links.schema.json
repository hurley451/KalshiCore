{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalshicore.dev/sources/schemas/docs-links.schema.json",
  "title": "KalshiCore docs link inventory",
  "type": "object",
  "required": [
    "sourceId",
    "url",
    "sha256",
    "linkCount",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "linkCount": {
      "type": "integer",
      "minimum": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
