{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kalshicore.dev/contracts/schemas/official-coverage.schema.json",
  "title": "KalshiCore official operation coverage",
  "type": "object",
  "required": [
    "sourceId",
    "generatedAt",
    "operationCount",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "operationCount": {
      "type": "integer",
      "minimum": 1
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operationId",
          "path",
          "method",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "reviewed",
              "unreviewed",
              "future",
              "irrelevant"
            ]
          },
          "contractId": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
