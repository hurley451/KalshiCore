{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "formatVersion", "bundle", "sourceHashes", "counts", "operations", "channels"],
  "properties": {
    "$schema": { "type": "string" }, "formatVersion": { "const": 1 }, "bundle": { "const": "current-official.json" },
    "sourceHashes": { "type": "object", "required": ["openapi", "asyncapi"], "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "channels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "entry": { "type": "object", "additionalProperties": false, "required": ["id", "contract", "schemaAccounting", "disposition", "effective"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "contract": { "type": "string", "pattern": "^current-official.json#/" }, "schemaAccounting": { "const": "complete" }, "disposition": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["reviewed", "unreviewed", "future", "irrelevant"] } } }, "effective": { "enum": ["future-disposition", "present-in-source"] } }
    }
  }
}
