{
  "$schema": "../schemas/sdk-target.schema.json",
  "id": "csharp.KalshiSharp",
  "language": "csharp",
  "repository": {
    "name": "KalshiSharp",
    "url": "https://github.com/hurley451/KalshiSharp"
  },
  "package": {
    "ecosystem": "nuget",
    "name": "KalshiSharp"
  },
  "adapter": {
    "workingDirectory": ".",
    "offlineCommand": "dotnet run --project KalshiSharp.Conformance/KalshiSharp.Conformance.csproj --configuration Release -- --kalshicore-root ${KALSHICORE_ROOT} --report artifacts/kalshicore-conformance/report.json",
    "reportPath": "artifacts/kalshicore-conformance/report.json",
    "requiredEnvironment": [
      "KALSHICORE_ROOT"
    ]
  },
  "conformance": {
    "status": "example",
    "kalshiCoreRef": "main",
    "contractIds": [
      "portfolio.fills.list"
    ],
    "fixtureIds": [
      "auth.signing.rest-get-portfolio-fills",
      "rest.request.portfolio-fills-query",
      "rest.response.portfolio-fills-page",
      "websocket.replay.orderbook-delta"
    ],
    "exclusions": []
  }
}
